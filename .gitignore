# Keep the models directory
!data/models/

# Generated model training outputs stay local by default.
# Already tracked model files stay tracked; force-add curated new runs explicitly.
# Keep lightweight report artifacts visible so experiment evidence is reviewable.
/data/models/**/*
!/data/models/**/
!/data/models/**/*report*.json
!/data/models/**/*report*.jsonl
!/data/models/**/*replay*.json
!/data/models/**/*replay*.jsonl

# Ignore profiling artifacts under models
/data/models/parallel_profiles_*/

# Ignore the run directory, but keep the .gitkeep file
run/
